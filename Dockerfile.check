# =============================================================================
# Dockerfile.check — KPHP binary build + PHAR build verification
#
# This Dockerfile verifies that lphenom/db:
#   1. Compiles cleanly with KPHP (produces a working binary)
#   2. Can be packaged as a PHAR archive
#
# Usage:
#   docker build -f Dockerfile.check -t lphenom-db-check .
#
# Both build stages must succeed (exit 0) for the check to pass.
# =============================================================================

# -----------------------------------------------------------------------------
# Stage 1: KPHP binary build
# Uses the official vkcom/kphp image (Ubuntu 20.04 focal, KPHP + PHP 7.4-vkext).
# KPHP parses the source with its own PHP parser — it does NOT need PHP 8.1
# at compile time; the output binary runs without PHP.
#
# FFI driver (FfiMySqlConnection + FfiMySqlResult) is fully included.
# KPHP resolves all mysql_*() method types at compile time from:
#   src/Driver/mysql.h  (annotated // @kphp-ffi-scope mysql)
# via FFI::scope('mysql') in lphenom_db_mysql_get_ffi().
#
# libmysqlclient-dev is installed so that:
#   - KPHP's C++ backend can link the generated FFI calls at compile time.
#   - The compiled binary can dlopen libmysqlclient.so.21 at runtime.
# PDO driver (PdoMySqlConnection) is excluded from KPHP build because
# PDO is not available in KPHP runtime.
# -----------------------------------------------------------------------------
FROM vkcom/kphp:latest AS kphp-build

# Install libmysqlclient-dev for FFI linking + optional vkext for dev tooling.
RUN apt-get update -qq \
    && apt-get install -y --no-install-recommends \
         wget ca-certificates \
         libmysqlclient-dev \
    && wget -q --timeout=10 -O /etc/apt/trusted.gpg.d/vkpartner.asc \
         https://artifactory-external.vkpartner.ru/artifactory/api/gpg/key/public \
    && echo "deb [arch=amd64] https://artifactory-external.vkpartner.ru/artifactory/kphp focal main" \
         > /etc/apt/sources.list.d/vkpartner.list \
    && apt-get update -qq \
    && apt-get install -y --no-install-recommends php8.1-vkext \
    && echo "=== php8.1-vkext installed ===" \
    || echo "=== php8.1-vkext SKIPPED (no network or repo unavailable — OK for compilation) ===" \
    ; rm -rf /var/lib/apt/lists/*

WORKDIR /build

# Copy only the source files needed for compilation
COPY src/    ./src/
COPY build/  ./build/

# Make mysql.h discoverable by KPHP from the working directory.
# KPHP scans the working directory for *.h files with // @kphp-ffi-scope annotations.
RUN cp /build/src/Driver/mysql.h /build/mysql.h

# Compile to binary.
# --output-dir: where to put the compiled binary
# --mode cli:   single-run CLI binary (vs server mode)
# kphp exits non-zero on any compilation error, failing the Docker build.
RUN kphp \
        -d /build/kphp-out \
        -M cli \
        /build/build/kphp-entrypoint.php \
    && echo "=== KPHP compilation: OK ===" \
    && ls -lh /build/kphp-out/

# Run the compiled binary to verify it actually works.
# KPHP CLI binaries refuse to run as root — create a test user.
RUN useradd -m kphp-runner \
    && su kphp-runner -c '/build/kphp-out/cli' \
    && echo "=== KPHP binary run: OK ==="

# -----------------------------------------------------------------------------
# Stage 2: PHAR (shared-hosting) build
# Uses PHP 8.1 with phar.readonly=0.
# Produces a self-contained PHAR that can be dropped onto shared hosting.
# -----------------------------------------------------------------------------
FROM php:8.1.31-cli-alpine AS phar-build

WORKDIR /build

# phar.readonly must be Off to allow creating PHAR archives
RUN echo "phar.readonly = Off" > /usr/local/etc/php/conf.d/phar.ini

# Install Composer (pinned version matching docker-compose.yml)
COPY --from=composer:2.9.5 /usr/bin/composer /usr/bin/composer

# Copy project files
COPY src/          ./src/
COPY build/        ./build/
COPY composer.json ./composer.json

# Install production dependencies only (no dev)
RUN composer install \
        --no-dev \
        --no-progress \
        --prefer-dist \
        --optimize-autoloader \
        --no-interaction

# Build the PHAR
RUN php -d phar.readonly=0 /build/build/build-phar.php

# Smoke-test: load the PHAR and verify autoloading works
RUN php /build/build/smoke-test-phar.php /build/lphenom-db.phar \
    && echo "=== PHAR build: OK ==="

# -----------------------------------------------------------------------------
# Final stage — copies both artefacts, proves both stages completed
# -----------------------------------------------------------------------------
FROM scratch AS check-complete
COPY --from=kphp-build /build/kphp-out/cli      /kphp-cli-binary
COPY --from=phar-build /build/lphenom-db.phar   /lphenom-db.phar

